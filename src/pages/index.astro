---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  formatWritingDate,
  getVisibleWriting,
  writingActivityDate,
  writingHref,
} from "../lib/writing";

const entries = await getVisibleWriting();
---

<BaseLayout title="Writing" description="一条不分栏的写作流。">
  <section class="home-heading">
    <p class="eyebrow">Index</p>
    <h1>写下来的东西</h1>
  </section>

  <section class="writing-index" aria-label="文章列表">
    {
      entries.map((entry) => {
        const activityDate = writingActivityDate(entry);

        return (
          <article class="writing-row">
            <a class="writing-link" href={writingHref(entry)}>
              <div class="writing-meta">
                <time datetime={activityDate.toISOString()}>
                  {entry.data.updated ? "更新 " : "发布 "}
                  {formatWritingDate(activityDate)}
                </time>
                {entry.data.draft && <span class="draft-label">draft</span>}
              </div>
              <div class="writing-copy">
                <h2>{entry.data.title}</h2>
                <p>{entry.data.summary}</p>
                {entry.data.tags.length > 0 && (
                  <ul class="tag-list" aria-label="关键词">
                    {entry.data.tags.map((tag) => <li>{tag}</li>)}
                  </ul>
                )}
              </div>
              <span class="row-arrow" aria-hidden="true">↗</span>
            </a>
          </article>
        );
      })
    }
  </section>
</BaseLayout>

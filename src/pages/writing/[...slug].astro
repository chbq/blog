---
import { render, type CollectionEntry } from "astro:content";

import ArticleToc from "../../components/ArticleToc.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  formatWritingDate,
  getVisibleWriting,
  writingHref,
} from "../../lib/writing";

export async function getStaticPaths() {
  const entries = await getVisibleWriting();

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"writing">;
}

const plainHeadingText = (source: string) =>
  source
    .replace(/!\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .replace(/\$([^$]+)\$/g, "$1")
    .replace(/\\;/g, " ")
    .replace(/`([^`]+)`/g, "$1")
    .replace(/[~*]/g, "")
    .replace(/\s+#+\s*$/, "")
    .replace(/\s+/g, " ")
    .trim();

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const sourceHeadings = Array.from(
  entry.body?.matchAll(/^(#{2,3})[ \t]+(.+)$/gm) ?? [],
).map((match) => plainHeadingText(match[2]));
const outline = headings
  .filter((heading) => heading.depth === 2 || heading.depth === 3)
  .map((heading, index) => ({
    ...heading,
    text: sourceHeadings[index] || heading.text,
  }));
const showOutline = outline.length >= 2;
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <div
    class:list={["article-layout", { "article-layout--with-toc": showOutline }]}
    data-article-layout
  >
    {
      showOutline && (
        <aside class="article-toc-desktop">
          <ArticleToc headings={outline} showTitle={true} />
        </aside>
      )
    }

    <article class="article-shell">
      <a class="back-link" href="/">← 全部文章</a>

      <header class="article-header">
        <div class="article-meta">
          <time datetime={entry.data.date.toISOString()}>
            发布于 {formatWritingDate(entry.data.date)}
          </time>
          {entry.data.updated && (
            <span>更新于 {formatWritingDate(entry.data.updated)}</span>
          )}
          {entry.data.draft && <span class="draft-label">draft</span>}
        </div>
        <h1>{entry.data.title}</h1>
        {entry.data.summary && <p class="article-summary">{entry.data.summary}</p>}
        {entry.data.tags.length > 0 && (
          <ul class="tag-list" aria-label="关键词">
            {entry.data.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )}
      </header>

      {
        showOutline && (
          <details class="article-toc-mobile">
            <summary>目录</summary>
            <ArticleToc headings={outline} />
          </details>
        )
      }

      <div class="article-body">
        <Content />
      </div>

      <footer class="article-footer">
        <a href={writingHref(entry)}>回到本文开头 ↑</a>
      </footer>
    </article>
  </div>
</BaseLayout>

<script>
  import "../../scripts/article-outline";
</script>

---
import "katex/dist/katex.min.css";
import "../styles/foundation.css";

interface Props {
  title?: string;
  description?: string;
  showGithub?: boolean;
}

const {
  title = "Writing",
  description = "A personal technical blog.",
  showGithub = false,
} = Astro.props;
const pageTitle = title === "Writing" ? title : `${title} — Writing`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href="/">Writing</a>
      <span class="site-mark" aria-hidden="true">↘</span>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>© 2026 m_pkw. All rights reserved.</p>
      {
        showGithub && (
          <a
            class="footer-link"
            href="https://github.com/chbq"
            aria-label="在 GitHub 查看 chbq 的主页"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path
                fill="currentColor"
                d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.23.7-3.91-1.37-3.91-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.74-1.55-2.58-.29-5.29-1.29-5.29-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.19-1.49 3.15-1.18 3.15-1.18.63 1.58.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.72 5.39-5.3 5.68.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"
              />
            </svg>
            <span>GitHub</span>
          </a>
        )
      }
    </footer>
  </body>
</html>
